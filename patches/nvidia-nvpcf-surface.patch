--- a/kernel-open/nvidia/nv-acpi.c	2026-11-19 20:33:09.199511280 +0200
+++ b/kernel-open/nvidia/nv-acpi.c	2026-11-19 20:33:09.307090609 +0200
@@ -793,10 +793,58 @@
         pathname   = "\\_SB.NPCF._DSM";
     }
 
+    if (acpiNvpcfDsmFunction && acpiDsmSubFunction == 8)
+    {
+        static const NvU8 mock_dc_table[21] = {
+            0x10, 0x04, 0x11, 0x01,
+            100,
+            0x10, 0x27, 0x00, 0x00,
+            0x98, 0x3A, 0x00, 0x00,
+            0x98, 0x3A, 0x00, 0x00,
+            0xB8, 0x88, 0x00, 0x00
+        };
+        if (pOutData && pSize && *pSize >= sizeof(mock_dc_table))
+        {
+            memcpy(pOutData, mock_dc_table, sizeof(mock_dc_table));
+            *pSize = sizeof(mock_dc_table);
+            nv_printf(NV_DBG_ERRORS, "NVRM: Synthesized Surface DC Power Limits Table for NVPCF Subfunc 8\n");
+            os_free_mem(argument3);
+            return NV_OK;
+        }
+    }
+
     rmStatus = nv_acpi_evaluate_dsm_method(dev_handle, pathname, pAcpiDsmGuid, acpiDsmRev,
                                            acpiDsmSubFunction, argument3, inParamSize,
                                            NV_FALSE, NULL, pOutData, pSize);
 
+    if (rmStatus == NV_OK && acpiNvpcfDsmFunction && acpiDsmSubFunction == 1)
+    {
+        NvU8 *pBuf = (NvU8 *)pOutData;
+        if (pBuf && pSize && *pSize >= 27)
+        {
+            if (pBuf[0] == 0x20 && pBuf[4] == 0x21 && (pBuf[0x16] & 0x01))
+            {
+                NvU16 i;
+                NvU8 csum = 0;
+
+                nv_printf(NV_DBG_ERRORS,
+                          "NVRM: Surface NVPCF Experiment A: clearing QBOOST_DC_SUPPORT at 0x16\n");
+                pBuf[0x16] &= ~0x01;
+
+                for (i = 0; i < (*pSize - 1); i++)
+                {
+                    csum += pBuf[i];
+                }
+                csum = (~csum) + 1;
+
+                nv_printf(NV_DBG_ERRORS,
+                          "NVRM: Surface NVPCF Experiment A: updated csum at 0x%02x from 0x%02x to 0x%02x\n",
+                          *pSize - 1, pBuf[*pSize - 1], csum);
+                pBuf[*pSize - 1] = csum;
+            }
+        }
+    }
+
     os_free_mem(argument3);
     return rmStatus;
 }
